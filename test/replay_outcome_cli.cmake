file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GENERATOR}" --fixture "${CASE}" "${WORK}/fixture.foz"
    RESULT_VARIABLE generated TIMEOUT 20 WORKING_DIRECTORY "${WORK}")
if(NOT generated STREQUAL "0")
    message(FATAL_ERROR "R14/${CASE}: checked fixture failed: ${generated}")
endif()
if(CASE STREQUAL "compatibility")
    execute_process(COMMAND "${CALLER}" "${REPLAY}" "${WORK}/fixture.foz"
        RESULT_VARIABLE status TIMEOUT 60 WORKING_DIRECTORY "${WORK}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "R14/old-source ExternalReplayer: ${status}")
    endif()
    return()
endif()
if(DEFINED CONTROLLER)
    execute_process(COMMAND "${CONTROLLER}" --controller "${SCENARIO}" "${WORK}/fixture.foz"
        RESULT_VARIABLE status TIMEOUT 40 WORKING_DIRECTORY "${WORK}")
    if(NOT status STREQUAL "1")
        message(FATAL_ERROR "R14/${SCENARIO}: production controller assertions failed: ${status}")
    endif()
    return()
endif()
set(expected 1)
if(CASE STREQUAL "good" OR CASE STREQUAL "empty" OR CASE STREQUAL "selection" OR CASE STREQUAL "hashselection" OR CASE STREQUAL "whitelist")
    set(expected 0)
endif()
if(CASE STREQUAL "whitelist")
    execute_process(COMMAND "${GENERATOR}" --whitelist "${WORK}/whitelist.foz" RESULT_VARIABLE generated TIMEOUT 10)
    if(NOT generated STREQUAL "0")
        message(FATAL_ERROR "R14/whitelist generation failed: ${generated}")
    endif()
endif()
foreach(mode normal child master progress)
    if(mode STREQUAL "child" AND CASE STREQUAL "whitelist")
        continue() # Direct child consumes the controller's filtered metadata, not whitelist CLI options.
    endif()
    foreach(threads 1 4)
        if(mode STREQUAL "child" AND threads EQUAL 4)
            continue() # CLI deliberately forces one replay thread in direct child.
        endif()
        set(args --null-device --num-threads ${threads})
        if(mode STREQUAL "child")
            list(APPEND args --slave-process)
        elseif(mode STREQUAL "master")
            list(APPEND args --master-process)
        elseif(mode STREQUAL "progress")
            list(APPEND args --progress --quiet-slave)
        endif()
        if(CASE STREQUAL "validation")
            list(APPEND args --spirv-val)
        elseif(CASE STREQUAL "missinghash" OR CASE STREQUAL "emptyhash")
            list(APPEND args --pipeline-hash fff)
        elseif(CASE STREQUAL "hashselection")
            list(APPEND args --pipeline-hash 201)
        elseif(CASE STREQUAL "whitelist")
            list(APPEND args --on-disk-replay-whitelist "${WORK}/whitelist.foz" --on-disk-replay-whitelist-mask 80)
        elseif(CASE STREQUAL "selection")
            # Explicit selection excludes the malformed third record.
            list(APPEND args --compute-pipeline-range 0 2)
        endif()
        execute_process(COMMAND "${REPLAY}" ${args} "${WORK}/fixture.foz"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30 WORKING_DIRECTORY "${WORK}")
        file(WRITE "${WORK}/${mode}-${threads}.stdout" "${output}")
        file(WRITE "${WORK}/${mode}-${threads}.stderr" "${errors}")
        if(NOT status STREQUAL "${expected}")
            message(FATAL_ERROR "R14/${CASE}/${mode}/${threads}: expected ${expected}, got ${status}\n${errors}")
        endif()
        if(CASE STREQUAL "mixed" AND mode STREQUAL "child")
            if(NOT output MATCHES "REPLAY_FAILED 2 1")
                message(FATAL_ERROR "R14/mixed/direct-child: missing exact authoritative Parse/drained terminal: ${output}")
            endif()
        endif()
        if(DEFINED BASELINE_REPLAY AND (CASE STREQUAL "e7" OR CASE STREQUAL "good"))
            execute_process(COMMAND "${BASELINE_REPLAY}" ${args} "${WORK}/fixture.foz"
                RESULT_VARIABLE baseline_status OUTPUT_VARIABLE baseline_output ERROR_VARIABLE baseline_errors
                TIMEOUT 30 WORKING_DIRECTORY "${WORK}")
            file(WRITE "${WORK}/baseline-${mode}-${threads}.stderr" "${baseline_errors}")
            file(WRITE "${WORK}/baseline-${mode}-${threads}.status" "${baseline_status}")
            if(NOT baseline_status STREQUAL "0")
                message(FATAL_ERROR "R14/original-defect: baseline expected false-success/clean zero, got ${baseline_status}")
            endif()
        endif()
        message(STATUS "Executed R14/CLI/${CASE}/${mode}/${threads}: ${status}")
    endforeach()
endforeach()
