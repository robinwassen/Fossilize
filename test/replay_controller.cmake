if(CASE STREQUAL "empty-archive")
    set(fixture_mode --empty)
else()
    set(fixture_mode --fixture)
endif()
execute_process(COMMAND "${CONTROLLER}" ${fixture_mode} fixture.foz RESULT_VARIABLE fixture_status TIMEOUT 15)
if(NOT fixture_status STREQUAL "0")
    message(FATAL_ERROR "Fixture creation failed: ${fixture_status}")
endif()
execute_process(COMMAND "${CONTROLLER}" --controller "${CASE}" fixture.foz
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
file(WRITE "controller.stdout" "${output}")
file(WRITE "controller.stderr" "${errors}")
if(CASE STREQUAL "clean" OR CASE STREQUAL "zero" OR CASE STREQUAL "empty-archive" OR CASE STREQUAL "recover" OR CASE STREQUAL "outcome-state")
    set(expected 0)
else()
    set(expected 1)
endif()
if(NOT status STREQUAL "${expected}")
    message(FATAL_ERROR "${CASE}: expected ${expected}, observed ${status}\n${output}\n${errors}")
endif()
message(STATUS "${output}")
