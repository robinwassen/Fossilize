execute_process(COMMAND "${CODEC}" startup-files "${WORK}" RESULT_VARIABLE generated TIMEOUT 20)
if(NOT generated STREQUAL "0")
    message(FATAL_ERROR "M18/startup-helper-and-byte-corpus: ${generated}")
endif()
execute_process(COMMAND "${GENERATOR}" --empty "${WORK}/empty.foz" RESULT_VARIABLE generated TIMEOUT 20)
if(NOT generated STREQUAL "0")
    message(FATAL_ERROR "M18/startup-empty-fixture: ${generated}")
endif()
file(GLOB inputs "${WORK}/*.input")
list(LENGTH inputs count)
if(count LESS 30)
    message(FATAL_ERROR "M18/startup-corpus-missing: ${count}")
endif()
foreach(input IN LISTS inputs)
    get_filename_component(case "${input}" NAME_WE)
    execute_process(COMMAND "${REPLAY}" --slave-process --null-device --num-threads 1
        --graphics-pipeline-range 0 0 --compute-pipeline-range 0 0 --raytracing-pipeline-range 0 0 "${WORK}/empty.foz"
        INPUT_FILE "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5
        WORKING_DIRECTORY "${WORK}")
    if(case MATCHES "^reject-")
        if(NOT status STREQUAL "1" OR output MATCHES "FZ18")
            message(FATAL_ERROR "M18/production-startup-reject/${case}: status=${status} output=${output}")
        endif()
    elseif(case MATCHES "^valid")
        if(NOT status STREQUAL "0" OR NOT output MATCHES "1 HELLO 7 9" OR NOT output MATCHES "1 FINAL 0 0")
            message(FATAL_ERROR "M18/production-startup-negotiated/${case}: status=${status} output=${output}")
        endif()
    elseif(NOT status STREQUAL "0" OR output MATCHES "FZ18")
        message(FATAL_ERROR "M18/production-startup-legacy/${case}: status=${status} output=${output}")
    endif()
    message(STATUS "M18/production-startup/${case}: status=${status}")
endforeach()
message(STATUS "M18/production-startup exact-byte cases=${count}")
