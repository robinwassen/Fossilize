file(MAKE_DIRECTORY "${WORK}")
foreach(kind support dependency)
    foreach(mode loud quiet)
        execute_process(COMMAND "${WORKER}" --controller event-${kind} ${WORK}/${kind}.foz ${mode}
            WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 35)
        file(WRITE "${WORK}/${kind}-${mode}.stderr" "${errors}")
        file(WRITE "${WORK}/${kind}-${mode}.stdout" "${output}")
        if(NOT result EQUAL 0 OR NOT output MATCHES "failures=0")
            message(FATAL_ERROR "M19/actual-worker-pipe-counters-final-native-outcome ${kind}/${mode}: ${result}\n${output}\n${errors}")
        endif()
        if(mode STREQUAL "loud")
            if(NOT errors MATCHES "Replay warning summary:" OR NOT errors MATCHES "attempt replay observations")
                message(FATAL_ERROR "M19/nonquiet-worker-summary: ${errors}")
            endif()
        elseif(errors MATCHES "Replay warning summary:")
            message(FATAL_ERROR "M19/quiet-worker-warning-suppression: ${errors}")
        endif()
        if(output MATCHES "Replay warning summary:" OR errors MATCHES "Did not replay blob|Unrecognized pNext|Replay/support:|Replay/dependency:")
            message(FATAL_ERROR "M19/worker-stdout-clean-no-duplicate-bypass: ${output}\n${errors}")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND "${GENERATOR}" --fixture "${WORK}/missing.foz" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "M19/shipped-cli-fixture")
endif()
foreach(mode normal slave master)
    set(args --null-device --num-threads 1 --disable-signal-handler)
    if(mode STREQUAL "slave")
        list(APPEND args --slave-process)
    elseif(mode STREQUAL "master")
        list(APPEND args --master-process)
    endif()
    execute_process(COMMAND "${REPLAY}" ${args} "${WORK}/missing.foz" INPUT_FILE /dev/null
        WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 35)
    file(WRITE "${WORK}/cli-${mode}.stderr" "${errors}")
    if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR NOT errors MATCHES "Replay warning summary:")
        message(FATAL_ERROR "M19/shipped-cli-outcome-clean-stdout-summary ${mode}: ${result}\n${output}\n${errors}")
    endif()
endforeach()
message(STATUS "M19 real prose CLI/worker, quiet pipes and exact rich counts passed")
