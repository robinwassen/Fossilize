execute_process(COMMAND "${CALLER}" "${WORK}/compatibility.foz"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if (NOT status EQUAL 0)
    message(FATAL_ERROR "Old-source caller failed: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${REPLAY}" --null-device --num-threads 1 "${WORK}/compatibility.foz"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
file(WRITE "${WORK}/replay.log" "${output}${error}")
if (NOT status EQUAL 0)
    message(FATAL_ERROR "Preserved CLI invocation failed: ${status}\n${output}\n${error}")
endif()
foreach(kind graphics compute raytracing)
    if (NOT error MATCHES "Playing back 1 ${kind} pipelines")
        message(FATAL_ERROR "Missing expected ${kind} resource: ${error}")
    endif()
endforeach()
set(expected_summary "Fossilize INFO: Replay reconciliation scope=full discovery=complete selected=3 selected_total=known created=3 cache_hint=0 unsupported=0 dependency_blocked=0 read_failed=0 parse_failed=0 create_failed=0 validation_failed=0 other_failed=0 crash_skipped=0 no_execution=0 blacklisted=0 unknown=0 conflicts=0 workers=1 attempts=1 failed_attempts=0 omitted_attempts=0 items_with_omitted_history=0.")
string(REGEX MATCHALL "Fossilize INFO: Replay reconciliation [^\n]*" summaries "${error}")
if (NOT summaries STREQUAL expected_summary)
    message(FATAL_ERROR "Successful compatibility replay did not reconcile all three creations: ${error}")
endif()
string(REPLACE "${expected_summary}\n" "" diagnostics "${error}")
if (diagnostics MATCHES "ERROR|failed|Failed|unsupported")
    message(FATAL_ERROR "Successful compatibility replay emitted failure: ${error}")
endif()
message(STATUS "COMPATIBILITY: old caller, known resource/hash set and preserved --null-device invocation passed")
