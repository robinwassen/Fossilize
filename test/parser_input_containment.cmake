# A normal false return plus exact continuation markers is the containment oracle.
# Baseline probes intentionally expect abnormal termination only in the isolated
# unchanged Debug library; that never substitutes for a passing candidate test.
if(DEFINED BASELINE_RUNNER)
    execute_process(COMMAND "${BASELINE_RUNNER}" valid RESULT_VARIABLE valid_status
        OUTPUT_VARIABLE valid_output ERROR_VARIABLE valid_errors TIMEOUT 30)
    if(NOT valid_status STREQUAL "0" OR NOT valid_output MATCHES "PARSER_COMPLETE mode=valid failures=0")
        message(FATAL_ERROR "Baseline valid controls failed: ${valid_status}\n${valid_output}\n${valid_errors}")
    endif()
    foreach(probe envelope nested)
        execute_process(COMMAND "${BASELINE_RUNNER}" --probe-${probe} RESULT_VARIABLE baseline_status
            OUTPUT_VARIABLE baseline_output ERROR_VARIABLE baseline_errors TIMEOUT 15)
        if(baseline_status STREQUAL "0" OR baseline_output MATCHES "PROBE_SENTINEL")
            message(FATAL_ERROR "Original ${probe} defect was not reproduced: ${baseline_status}\n${baseline_output}\n${baseline_errors}")
        endif()
        # Require the known RapidJSON assertion; a timeout or build/link failure
        # is not evidence that the original parser defect ran.
        if(NOT baseline_errors MATCHES "Assertion.*(MemberEnd|IsObject|false)")
            message(FATAL_ERROR "Unexpected baseline ${probe} failure: ${baseline_status}\n${baseline_errors}")
        endif()
        execute_process(COMMAND "${RUNNER}" --probe-${probe} RESULT_VARIABLE status
            OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
        if(NOT status STREQUAL "0" OR NOT output MATCHES "PROBE_SENTINEL --probe-${probe} failures=0")
            message(FATAL_ERROR "Candidate ${probe} not contained: ${status}\n${output}\n${errors}")
        endif()
        message(STATUS "BASELINE_${probe} status=${baseline_status}; known RapidJSON assertion; candidate=${status}; candidate sentinel present")
    endforeach()
    message(STATUS "Baseline valid callbacks/bytes/hash controls passed; both original defects reproduced")
    return()
endif()
execute_process(COMMAND "${RUNNER}" --inventory RESULT_VARIABLE inventory_status OUTPUT_VARIABLE inventory TIMEOUT 15)
if(NOT inventory_status STREQUAL "0")
    message(FATAL_ERROR "Parser table inventory failed: ${inventory_status}")
endif()
string(REGEX MATCHALL "CASE [^\r\n]+" cases "${inventory}")
list(LENGTH cases expected)
if(expected LESS 200)
    message(FATAL_ERROR "Vacuous parser fixture inventory: ${expected}")
endif()
execute_process(COMMAND "${RUNNER}" sentinel RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Parser sentinel subprocess failed: ${status}\n${output}\n${errors}")
endif()
string(REGEX MATCHALL "CONTINUED [^\r\n]+" continued "${output}")
list(LENGTH continued actual)
if(NOT actual EQUAL expected)
    message(FATAL_ERROR "Continuation count differs: expected=${expected}; actual=${actual}")
endif()
foreach(case IN LISTS cases)
    string(REPLACE "CASE " "CONTINUED " marker "${case}")
    list(FIND continued "${marker}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Missing continuation: ${marker}")
    endif()
endforeach()
if(NOT output MATCHES "PARSER_sentinel_SENTINEL cases=${expected} failures=0" OR
   NOT output MATCHES "PARSER_COMPLETE mode=sentinel failures=0")
    message(FATAL_ERROR "Missing final parser sentinel: ${output}")
endif()
message(STATUS "Parser subprocess continued after all ${expected} rejected fixtures; exact inventory/marker union and final sentinel passed")
