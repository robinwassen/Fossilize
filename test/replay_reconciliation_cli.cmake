execute_process(COMMAND "${GENERATOR}" --fixture selection.foz RESULT_VARIABLE fixture TIMEOUT 10)
if(NOT fixture STREQUAL "0")
    message(FATAL_ERROR "R21/CLI fixture failed with status ${fixture}")
endif()
configure_file(selection.foz overlap.foz COPYONLY)
foreach(mode normal master quiet-master progress hash-master)
    set(args --null-device --num-threads 2 --loop 2)
    if(mode STREQUAL "master" OR mode STREQUAL "quiet-master" OR mode STREQUAL "hash-master")
        list(APPEND args --master-process)
    elseif(mode STREQUAL "progress")
        list(APPEND args --progress)
    endif()
    if(mode STREQUAL "quiet-master")
        list(APPEND args --quiet-slave)
    endif()
    if(mode STREQUAL "hash-master")
        list(APPEND args --pipeline-hash 205)
        set(expected 1)
    else()
        # Include the consumer and its cross-tag equal hash, exclude the library.
        list(APPEND args --graphics-pipeline-range 0 3 --compute-pipeline-range 0 1)
        set(expected 4)
    endif()
    execute_process(COMMAND "${REPLAY}" ${args} selection.foz overlap.foz
        RESULT_VARIABLE status ERROR_VARIABLE log TIMEOUT 15)
    file(WRITE "${mode}.stderr" "${log}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "R21/CLI/${mode} expected a successful exit, got ${status}\n${log}")
    endif()
    if(mode STREQUAL "progress")
        continue()
    endif()
    string(REGEX MATCHALL "Replay reconciliation [^\n]+" summaries "${log}")
    list(LENGTH summaries count)
    if(NOT count EQUAL 1 OR NOT summaries MATCHES "scope=full discovery=complete selected=${expected} selected_total=known created=${expected} cache_hint=0 .*unknown=0 conflicts=0")
        message(FATAL_ERROR "R21/CLI/${mode} selected-item summary disagrees with the identity oracle\n${log}")
    endif()
    if(mode STREQUAL "quiet-master" AND log MATCHES "Playing back|Total binary size")
        message(FATAL_ERROR "R21/CLI/quiet-master leaked worker prose\n${log}")
    endif()
endforeach()
message(STATUS "Executed R21/CLI selection, composite duplicates, equal tag hashes, dependency, loops and quiet controls")
