if(NOT DEFINED REPLAY OR NOT DEFINED GENERATOR OR NOT DEFINED CASE OR NOT DEFINED WORK)
    message(FATAL_ERROR "D20 missing invocation arguments")
endif()
file(MAKE_DIRECTORY "${WORK}")
function(fixture kind name)
    execute_process(COMMAND "${GENERATOR}" --fixture "${kind}" "${WORK}/${name}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "D20 fixture ${kind} failed ${status}\n${out}\n${err}")
    endif()
endfunction()
fixture(empty empty.foz)
fixture(good good.foz)
file(COPY_FILE "${WORK}/empty.foz" "${WORK}/truncated.foz")
file(APPEND "${WORK}/truncated.foz" "slice")
file(COPY_FILE "${WORK}/good.foz" "${WORK}/prefix.foz")
file(APPEND "${WORK}/prefix.foz" "slice")
file(WRITE "${WORK}/invalid.foz" "invalid")
file(REMOVE "${WORK}/absent.foz")
file(WRITE "${WORK}/stdin" "")
function(run executable expected mode threads)
    set(args --null-device --num-threads "${threads}")
    if(NOT mode STREQUAL "normal")
        list(APPEND args "--${mode}")
    endif()
    execute_process(COMMAND "${executable}" ${args} ${ARGN} WORKING_DIRECTORY "${WORK}" INPUT_FILE "${WORK}/stdin"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 25)
    if(expected STREQUAL "success")
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "D20/${CASE}/${mode}/${threads} expected success got ${status}\n${out}\n${err}")
        endif()
    elseif(NOT status MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "D20/${CASE}/${mode}/${threads} expected ordinary unsuccessful exit got ${status}\n${out}\n${err}")
    endif()
endfunction()
if(CASE STREQUAL "original-defect")
    if(NOT DEFINED BASELINE_REPLAY)
        message(FATAL_ERROR "D20 original-defect requires unchanged baseline")
    endif()
    foreach(mode normal slave-process master-process progress)
        run("${BASELINE_REPLAY}" success "${mode}" 1 "${WORK}/empty.foz")
        run("${BASELINE_REPLAY}" success "${mode}" 1 "${WORK}/truncated.foz")
        run("${REPLAY}" success "${mode}" 1 "${WORK}/empty.foz")
        run("${REPLAY}" failure "${mode}" 1 "${WORK}/truncated.foz")
    endforeach()
    message(STATUS "D20/original-defect: compiled baseline false-success and healthy controls observed; candidate rejects unknown scope")
    return()
endif()
foreach(mode normal slave-process master-process progress)
    foreach(threads 1 4)
        if(CASE STREQUAL "empty")
            run("${REPLAY}" success "${mode}" "${threads}" "${WORK}/empty.foz")
        elseif(CASE STREQUAL "truncated-zero")
            run("${REPLAY}" failure "${mode}" "${threads}" "${WORK}/truncated.foz")
            run("${REPLAY}" failure "${mode}" "${threads}" --graphics-pipeline-range 0 0 --compute-pipeline-range 0 0 --raytracing-pipeline-range 0 0 "${WORK}/truncated.foz")
        elseif(CASE STREQUAL "prefix")
            run("${REPLAY}" failure "${mode}" "${threads}" "${WORK}/prefix.foz")
            run("${REPLAY}" success "${mode}" "${threads}" --accept-recovered-prefix "${WORK}/prefix.foz")
        elseif(CASE STREQUAL "required")
            foreach(bad absent.foz invalid.foz)
                run("${REPLAY}" failure "${mode}" "${threads}" "${WORK}/empty.foz" "${WORK}/${bad}")
                run("${REPLAY}" failure "${mode}" "${threads}" --accept-recovered-prefix "${WORK}/good.foz" "${WORK}/${bad}")
            endforeach()
        elseif(CASE STREQUAL "optional")
            foreach(bad absent.foz invalid.foz)
                run("${REPLAY}" success "${mode}" "${threads}" --optional-database-index 0 "${WORK}/${bad}")
                if(NOT mode STREQUAL "slave-process")
                    run("${REPLAY}" success "${mode}" "${threads}" --optional-database-index 0 --on-disk-replay-whitelist "${WORK}/good.foz" "${WORK}/${bad}")
                    run("${REPLAY}" failure "${mode}" "${threads}" --optional-database-index 0 --on-disk-replay-whitelist "${WORK}/absent.foz" "${WORK}/${bad}")
                endif()
                run("${REPLAY}" success "${mode}" "${threads}" --optional-database-index 1 "${WORK}/good.foz" "${WORK}/${bad}")
            endforeach()
            run("${REPLAY}" failure "${mode}" "${threads}" --optional-database-index 2 "${WORK}/good.foz")
        elseif(CASE STREQUAL "selection" OR CASE STREQUAL "legacy-invocations")
            run("${REPLAY}" success "${mode}" "${threads}" "${WORK}/good.foz")
            run("${REPLAY}" success "${mode}" "${threads}" --compute-pipeline-range 1 2 "${WORK}/good.foz")
            run("${REPLAY}" success "${mode}" "${threads}" --compute-pipeline-range 9 10 "${WORK}/good.foz")
            run("${REPLAY}" success "${mode}" "${threads}" --pipeline-hash 201 "${WORK}/good.foz")
            run("${REPLAY}" success "${mode}" "${threads}" --replayer-cache "${WORK}/hints" "${WORK}/good.foz")
            # Direct-child whitelist selection is an existing unsupported invocation.
            if(NOT mode STREQUAL "slave-process")
                run("${REPLAY}" success "${mode}" "${threads}" --on-disk-replay-whitelist "${WORK}/good.foz" "${WORK}/good.foz")
            endif()
        else()
            message(FATAL_ERROR "D20 unknown case ${CASE}")
        endif()
    endforeach()
endforeach()

if(CASE STREQUAL "legacy-invocations")
    foreach(format good.zip good.txt directory)
        execute_process(COMMAND "${GENERATOR}" --convert "${WORK}/good.foz" "${WORK}/${format}"
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "D20 old-format fixture ${format} failed ${status}\n${out}\n${err}")
        endif()
        foreach(mode normal slave-process)
            run("${REPLAY}" success "${mode}" 1 "${WORK}/${format}")
            run("${REPLAY}" success "${mode}" 1 --optional-database-index 0 "${WORK}/${format}")
        endforeach()
    endforeach()
endif()

if(CASE STREQUAL "truncated-zero" OR CASE STREQUAL "empty")
    file(WRITE "${WORK}/offer.input" "FZ18 13:1 OFFER 2 7 9\n")
    foreach(input empty.foz truncated.foz)
        execute_process(COMMAND "${REPLAY}" --slave-process --null-device --num-threads 1
            --graphics-pipeline-range 0 0 --compute-pipeline-range 0 0 --raytracing-pipeline-range 0 0 "${WORK}/${input}"
            INPUT_FILE "${WORK}/offer.input" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
        if(input STREQUAL "empty.foz")
            if(NOT status STREQUAL "0" OR NOT output MATCHES "1 HELLO 7 9" OR NOT output MATCHES "1 FINAL 0 0")
                message(FATAL_ERROR "D20 rich-empty scope control: ${status} ${output} ${errors}")
            endif()
        elseif(NOT status STREQUAL "1" OR NOT output MATCHES "1 FINAL 1 0")
            message(FATAL_ERROR "D20 rich-zero-work cannot erase incomplete discovery: ${status} ${output} ${errors}")
        endif()
    endforeach()
endif()
