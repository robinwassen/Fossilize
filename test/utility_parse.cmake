# Portable subprocess regression driver. GENERATOR and TOOL are independently
# overridable so the same assertions can exercise unchanged baseline utilities.
foreach(required GENERATOR TOOL TOOL_NAME CASE WORK)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(helper mode kind variant output input)
    execute_process(COMMAND "${GENERATOR}" "${mode}" "${TOOL_NAME}" "${kind}" "${variant}" "${output}" "${input}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    file(WRITE "${WORK}/${mode}-${kind}-${variant}.log" "status=${status}\n${out}${err}")
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "Fixture ${mode} ${kind}/${variant} failed (${status}): ${out}${err}")
    endif()
endfunction()
function(invoke name input tag connectivity size)
    if(TOOL_NAME STREQUAL "list")
        set(args "${input}" --tag "${tag}")
        if(connectivity)
            list(APPEND args --connectivity)
        endif()
        if(size)
            list(APPEND args --size)
        endif()
    else()
        set(args --input-db "${input}" --output-db "${WORK}/${name}-output.foz")
    endif()
    execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    file(WRITE "${WORK}/${name}.status" "${status}\n")
    file(WRITE "${WORK}/${name}.stdout" "${out}")
    file(WRITE "${WORK}/${name}.stderr" "${err}")
    # Numeric exit status proves normal termination; crash/signal/timeout is not
    # acceptable evidence of the declared parser-failure outcome.
    if(NOT "${status}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${name}: abnormal subprocess termination: ${status}\n${err}")
    endif()
    set(status "${status}" PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
function(success name)
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "${name}: expected zero exit, got ${status}\n${err}")
    endif()
    if(err MATCHES "Failed to parse blob|[Ii]ncomplete")
        message(FATAL_ERROR "${name}: unexpected failure diagnostic: ${err}")
    endif()
endfunction()
function(failure name tag hash)
    if(NOT "${status}" STREQUAL "1")
        message(FATAL_ERROR "${name}: expected parse-failure exit 1, got ${status}\nstdout=${out}\nstderr=${err}")
    endif()
    if(NOT err MATCHES "Failed to parse blob \\(tag: ${tag}, hash: 0x${hash}\\)" OR NOT err MATCHES "[Ii]ncomplete")
        message(FATAL_ERROR "${name}: missing affected scope/incomplete diagnostic: ${err}")
    endif()
    if(TOOL_NAME STREQUAL "list" AND NOT "${out}" STREQUAL "")
        message(FATAL_ERROR "${name}: rejected connectivity must emit no ordinary rows: ${out}")
    endif()
endfunction()

if(CASE STREQUAL "mixed" OR CASE STREQUAL "dependency-failure")
    set(variants version invalid-json)
elseif(CASE STREQUAL "rejected-application")
    set(variants version invalid-json after-callback)
else()
    set(variants default)
endif()
foreach(variant IN LISTS variants)
    set(input "${WORK}/${CASE}-${variant}-input.foz")
    # Every execution has fresh archives, even when CTest repeats a case.
    file(GLOB old "${WORK}/*.foz")
    if(old)
        file(REMOVE ${old})
    endif()
    if(CASE STREQUAL "legacy-invocations")
        foreach(kind empty populated invalid-json)
            set(input "${WORK}/${kind}-input.foz")
            helper(make "${kind}" default "${input}" unused)
            invoke("plain-${kind}" "${input}" 7 FALSE FALSE)
            success("plain-${kind}")
            if(kind STREQUAL "empty")
                set(wanted "")
            else()
                set(wanted "0000000000000104\n")
            endif()
            if(NOT "${out}" STREQUAL "${wanted}")
                message(FATAL_ERROR "ordinary enumeration changed: ${out}")
            endif()
            invoke("size-${kind}" "${input}" 7 FALSE TRUE)
            success("size-${kind}")
            if(kind STREQUAL "empty")
                if(NOT "${out}" STREQUAL "Total size (compressed): 0 bytes.\nTotal size (uncompressed): 0 bytes.\n")
                    message(FATAL_ERROR "empty size output changed: ${out}")
                endif()
            else()
                if(NOT out MATCHES "^0000000000000104 [0-9]+ compressed bytes, [0-9]+ uncompressed bytes\nTotal size \\(compressed\\): [0-9]+ bytes.\nTotal size \\(uncompressed\\): [0-9]+ bytes.\n$")
                    message(FATAL_ERROR "size output changed: ${out}")
                endif()
            endif()
        endforeach()
        continue()
    endif()
    helper(make "${CASE}" "${variant}" "${input}" unused)
    set(tag 7)
    if(CASE STREQUAL "empty-dependencies")
        set(tag 3)
    endif()
    set(name "${CASE}-${variant}")
    invoke("${name}" "${input}" "${tag}" TRUE FALSE)
    if(CASE STREQUAL "empty" OR CASE STREQUAL "populated" OR CASE STREQUAL "empty-dependencies")
        success("${name}")
        if(TOOL_NAME STREQUAL "list")
            if(CASE STREQUAL "empty")
                set(wanted "")
            elseif(CASE STREQUAL "populated")
                set(wanted "0000000000000104 : pipelineLayout(3):0000000000000102, shaderModule(4):0000000000000101, \n")
            else()
                set(wanted "0000000000000102 : \n")
            endif()
            if(NOT "${out}" STREQUAL "${wanted}")
                message(FATAL_ERROR "${name}: incorrect connectivity: [${out}] expected [${wanted}]")
            endif()
        else()
            helper(verify "${CASE}" "${variant}" "${WORK}/${name}-output.foz" "${input}")
        endif()
    else()
        set(bad_tag 7)
        set(bad_hash 104)
        if(CASE STREQUAL "mixed")
            if(TOOL_NAME STREQUAL "list")
                set(bad_hash 105)
            elseif(TOOL_NAME STREQUAL "rehash")
                set(bad_tag 1)
            else()
                set(bad_tag 0)
                set(bad_hash 102)
            endif()
        elseif(CASE STREQUAL "dependency-failure")
            set(bad_tag 3)
            set(bad_hash 102)
        elseif(CASE STREQUAL "rejected-application")
            set(bad_tag 0)
            set(bad_hash 102)
        endif()
        failure("${name}" "${bad_tag}" "${bad_hash}")
        if(NOT TOOL_NAME STREQUAL "list")
            if(CASE STREQUAL "mixed")
                set(output_kind mixed)
            else()
                set(output_kind failed)
            endif()
            helper(verify "${output_kind}" "${variant}" "${WORK}/${name}-output.foz" "${input}")
        endif()
    endif()
endforeach()
