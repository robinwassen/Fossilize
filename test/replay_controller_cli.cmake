file(MAKE_DIRECTORY "${WORK}")
if(CASE STREQUAL "e5" OR CASE STREQUAL "e6" OR CASE STREQUAL "parser-normal" OR CASE STREQUAL "parser-child")
    set(fixture_mode --malformed)
else()
    set(fixture_mode --fixture)
endif()
execute_process(COMMAND "${GENERATOR}" ${fixture_mode} "${WORK}/fixture.foz"
    RESULT_VARIABLE status TIMEOUT 20 WORKING_DIRECTORY "${WORK}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "checked fixture generation failed: ${status}")
endif()
if(CASE STREQUAL "compatibility")
    execute_process(COMMAND "${CALLER}" "${REPLAY}" "${GENERATOR}" "${WORK}/fixture.foz"
        RESULT_VARIABLE status TIMEOUT 40 WORKING_DIRECTORY "${WORK}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "ExternalReplayer compatibility failed: ${status}")
    endif()
    return()
endif()
set(arguments --null-device --num-threads 2)
if(CASE STREQUAL "e5" OR CASE STREQUAL "master")
    list(APPEND arguments --master-process)
elseif(CASE STREQUAL "e6" OR CASE STREQUAL "progress")
    list(APPEND arguments --progress --quiet-slave)
elseif(CASE STREQUAL "parser-child")
    list(APPEND arguments --slave-process)
endif()
execute_process(COMMAND "${REPLAY}" ${arguments} "${WORK}/fixture.foz"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30 WORKING_DIRECTORY "${WORK}")
file(WRITE "${WORK}/cli.stdout" "${output}")
file(WRITE "${WORK}/cli.stderr" "${errors}")
if(CASE STREQUAL "e5" OR CASE STREQUAL "e6" OR CASE STREQUAL "parser-normal" OR CASE STREQUAL "parser-child")
    set(expected 1)
    set(boundary "controlled-parser-rejection-orderly-item-failure")
    execute_process(COMMAND "${CALLER}" --parser-rejection "${REPLAY}" "${WORK}/fixture.foz"
        RESULT_VARIABLE rejection_status OUTPUT_VARIABLE rejection_output ERROR_VARIABLE rejection_errors
        TIMEOUT 30 WORKING_DIRECTORY "${WORK}")
    file(WRITE "${WORK}/parser-rejection.stdout" "${rejection_output}")
    file(WRITE "${WORK}/parser-rejection.stderr" "${rejection_errors}")
    if(NOT rejection_status STREQUAL "0")
        message(FATAL_ERROR "Structured parser-rejection/no-worker-loss control failed: ${rejection_status}\n${rejection_output}\n${rejection_errors}")
    endif()
    if(NOT errors MATCHES "reason=malformed-envelope field=version" OR
       NOT errors MATCHES "tag=7.*hash=0x0000000000000605" OR
       errors MATCHES "Assertion|segmentation|driver crash")
        message(FATAL_ERROR "Controlled input reason/compute identity missing or crash misattributed: ${errors}")
    endif()
    message(STATUS "${rejection_output}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "R13/${CASE}/${boundary}: expected status ${expected}; observed ${status}\n${errors}")
    endif()

else()
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Preserved successful invocation failed: ${status}\n${errors}")
    endif()
endif()
message(STATUS "Executed R13/CLI/${CASE}; boundary=${boundary}; status=${status}")
